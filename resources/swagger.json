{
    "openapi": "3.0.0",
    "info": {
        "title": "Notes API",
        "version": "1.0.0",
        "description": "RESTful API для управления мини-сервисом заметок"
    },
    "paths": {
        "/api/notes": {
            "get": {
                "summary": "Получить все заметки",
                "responses": {
                    "200": { "description": "Успешный возврат списка заметок" }
                }
            },
            "post": {
                "summary": "Создать новую заметку",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["title", "content"],
                                "properties": {
                                    "title": { "type": "string", "maxLength": 255 },
                                    "content": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Заметка успешно создана" },
                    "422": { "description": "Ошибка валидации данных" }
                }
            }
        },
        "/api/notes/{id}": {
            "get": {
                "summary": "Просмотр конкретной заметки",
                "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
                "responses": {
                    "200": { "description": "Успешный просмотр" },
                    "404": { "description": "Заметка не найдена" }
                }
            },
            "put": {
                "summary": "Редактировать заметку",
                "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["title", "content"],
                                "properties": {
                                    "title": { "type": "string", "maxLength": 255 },
                                    "content": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Заметка успешно обновлена" },
                    "422": { "description": "Ошибка валидации данных" },
                    "404": { "description": "Заметка не найдена" }
                }
            },
            "delete": {
                "summary": "Удалить заметку",
                "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
                "responses": {
                    "204": { "description": "Заметка успешно удалена" },
                    "404": { "description": "Заметка не найдена" }
                }
            }
        }
    }
}
